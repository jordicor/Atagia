{
  "name": "@atagia/openclaw-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native OpenClaw plugin for Atagia memory.",
  "main": "./index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "peerDependencies": {
    "openclaw": "2026.5.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "runtimeExtensions": [
      "./index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.5.6"
    },
    "compat": {
      "pluginApi": "2026.5.6"
    },
    "build": {
      "openclawVersion": "2026.5.6"
    }
  },
  "scripts": {
    "test": "node --test test.mjs"
  }
}
